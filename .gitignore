__pycache__/
*.pyc
.venv/

# Fetched by setup_mpv.py -- large, frequently-updated binaries that
# don't belong in git. Everything else in mpv-runtime/ (uosc, thumbfast,
# fonts, configs) is small and checked in directly.
/mpv-runtime/mpv.exe
/mpv-runtime/libmpv-2.dll
/mpv-runtime/yt-dlp.exe

# PyInstaller build output -- build.bat regenerates this; not committed.
/build/
/dist/
/AXPlayer.exe
/AXPlayer-onefile.exe
/AXPlayer/

# Local preview-server config for the docs/ site. Machine-specific.
.claude/

# Written by Fluid Motion into the config dir whenever it attaches to a
# player. Generated per machine (it names the local GPU in a comment), so it
# is not ours to commit -- it appeared here the first time a test run
# constructed a real embedded mpv while Fluid Motion was running.
/mpv-runtime/shaders/fluid_rife.vpy
